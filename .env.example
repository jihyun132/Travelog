# 로컬 개발: docker-compose.yml 기본값과 일치
# 배포: Neon 풀러(pooler) 엔드포인트 사용 권장 (?sslmode=require 포함)
DATABASE_URL=postgresql+psycopg://travelog:travelog@localhost:5432/travelog

JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# S3 (Week 3부터 사용)
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=

# Kakao 소셜 로그인 (P1)
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=
